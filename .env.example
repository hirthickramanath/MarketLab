# Local demonstration uses SQLite and fictional scenarios. Never deploy SQLite mode to Vercel.
MARKETLAB_DB_PATH=.data/marketlab.sqlite
# Optional demo administrator: set BOTH before startup; no default password.
MARKETLAB_ADMIN_EMAIL=
MARKETLAB_ADMIN_PASSWORD=
# Supabase production implementation is tracked in docs/IMPLEMENTATION.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to the exact trusted public origin when hosting behind a proxy.
MARKETLAB_APP_ORIGIN=
NEXT_PUBLIC_MARKETLAB_BRAND=MarketLab
